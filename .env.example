# Rename this file to .env and fill with your values

# Secret key for flask session management
SECRET_KEY=your_secret_key_here

# Database connection URL in SQLAlchemy format
DATABASE_URL=postgresql://YOUR_DB_USER:YOUR_DB_PASSWORD@localhost:5432/smartrag

# Max upload size in bytes (optional, default 10485760 = 10MB)
# MAX_CONTENT_LENGTH=10485760

# Folder where uploaded PDFs are stored
UPLOAD_FOLDER=uploads

APP_ENV=development
